APP_NAME=CMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cms
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CMS
CMS_THEME=enterprise
CMS_DEFAULT_LOCALE=zh_cn
CMS_HIDE_DEFAULT_LOCALE=true
CMS_FORM_CAPTCHA=true
CMS_AUTH_CAPTCHA=true
CMS_HTML_CACHE=false
CMS_HTML_CACHE_TTL=3600
CMS_DISK_HTML=false
CMS_IP_LOOKUP=true

# 媒体盘：默认 public。对象存储见后台「说明 → 环境」
# CMS_MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# 后台任务：schedule=定时同步 | queue=只投递队列 | off=不自动跑
CMS_SCHEDULE_ENABLED=true
CMS_COLLECT_MODE=schedule
CMS_COLLECT_QUEUE=cms
CMS_STAT_PRUNE_MODE=schedule
CMS_STAT_PRUNE_QUEUE=cms

# Security
FORCE_HTTPS=false
# 反代后面填 * 或代理 IP，否则 request()->ip() 会是 Docker 网关
TRUST_PROXIES=
PASSWORD_MIN_LENGTH=10
